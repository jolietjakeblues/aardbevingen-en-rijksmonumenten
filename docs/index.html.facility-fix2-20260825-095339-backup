<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aardbevingen NL - epicentrum &amp; rijksmonumenten</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  :root{
    --sidebar-w: 340px;
    --accent: #2c3e50;
    --border: #e2e2e2;
    --muted: #888;
  }
  html, body { margin:0; height:100%; font-family: -apple-system, "Segoe UI", Arial, sans-serif; color:#222; }
  #app { display:flex; height:100vh; }
  #sidebar {
    width: var(--sidebar-w); flex: 0 0 var(--sidebar-w);
    overflow-y: auto; background:#fff; border-right:1px solid var(--border);
    padding: 16px; box-sizing: border-box;
  }
  .logos-row { display:flex; align-items:center; gap:18px; margin-bottom:16px; }
  .brand-logo { display:block; flex-shrink:0; }
  #mapPane { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; }
  #map { flex: 1 1 auto; min-height: 0; }
  #timebar {
    flex: 0 0 auto; background: #fff; border-top: 1px solid var(--border);
    padding: 8px 16px; display: flex; align-items: center; gap: 10px; box-sizing: border-box;
  }
  #timebar button {
    flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border);
    background: #fff; cursor: pointer; font-size: 13px; display: flex; align-items: center; justify-content: center;
  }
  #timebar button:hover { background: #f5f5f5; }
  #timeYearLabel { flex: 0 0 auto; font-size: 13px; font-weight: 600; min-width: 78px; text-align:center; }
  #timeResetBtn { flex: 0 0 auto; font-size: 11px; color: var(--muted); background: none; border: none; cursor: pointer; text-decoration: underline; width: auto; height: auto; border-radius: 0; }

  /* Twee-handvat range-slider: twee overlappende native range-inputs (transparant, alleen de
     thumb is klikbaar) plus een losse track + fill-balk erachter voor het visuele effect. */
  .range-slider-wrap { position: relative; flex: 1 1 auto; height: 20px; }
  .range-track { position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: var(--border); border-radius: 1px; }
  .range-fill { position: absolute; top: 9px; height: 2px; background: var(--accent); border-radius: 1px; }
  .range-slider-wrap input[type=range] {
    position: absolute; top: 0; left: 0; width: 100%; height: 20px; margin: 0;
    -webkit-appearance: none; appearance: none; background: transparent; pointer-events: none;
  }
  .range-slider-wrap input[type=range]::-webkit-slider-runnable-track { background: transparent; }
  .range-slider-wrap input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; pointer-events: auto; width: 14px; height: 14px; margin-top: 3px;
    border-radius: 50%; background: var(--accent); border: 2px solid #fff; box-shadow: 0 0 0 1px var(--border); cursor: pointer;
  }
  .range-slider-wrap input[type=range]::-moz-range-track { background: transparent; border: none; }
  .range-slider-wrap input[type=range]::-moz-range-thumb {
    pointer-events: auto; width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 2px solid #fff; box-shadow: 0 0 0 1px var(--border); cursor: pointer;
  }
  .legend-control {
    background: #fff; border-radius: 4px; box-shadow: 0 1px 5px rgba(0,0,0,.4);
    font-size: 12px; max-width: 230px;
  }
  .legend-control-header {
    width: 100%; padding: 6px 10px; cursor: pointer; font-weight: 600; color: var(--accent);
    user-select: none; background: transparent; border: 0; text-align: left; font: inherit;
  }
  .legend-control-header:focus-visible { outline: 2px solid #1a5276; outline-offset: 2px; }
  .legend-control-body { padding: 0 10px 10px; }
  h1 { font-size: 16px; margin: 0; color: var(--accent); }
  .title-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 2px; }
  .help-toggle {
    flex: 0 0 auto; font-size: 11px; color: #1a5276; background: none; border: 1px solid var(--border);
    border-radius: 12px; padding: 3px 10px; cursor: pointer; font-family: inherit;
  }
  .help-toggle:hover { background: #f5f5f5; }
  .help-toggle:focus-visible { outline: 2px solid #1a5276; outline-offset: 2px; }
  .download-btn {
    margin-top: 8px; font-size: 12px; padding: 6px 12px; border: 1px solid var(--border);
    border-radius: 4px; background: #fff; cursor: pointer; font-family: inherit; color: #1a5276;
  }
  .download-btn:hover { background: #f5f5f5; }
  .filter-group { margin-bottom: 10px; }
  .filter-group h3 { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); margin: 0 0 6px; font-weight: 600; }
  .filter-chip {
    display: inline-block; margin: 0 6px 6px 0; padding: 4px 10px; font-size: 12px;
    border: 1px solid var(--border); border-radius: 14px; background: #fff; cursor: pointer; font-family: inherit;
  }
  .filter-chip:hover { background: #f5f5f5; }
  .filter-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .filter-count { opacity: 0.75; }
  .filter-active-row { font-size: 12px; margin-bottom: 10px; padding: 6px 8px; background: #f7f9fa; border-radius: 4px; }
  .filter-active-row button { margin-left: 6px; font-size: 11px; padding: 2px 8px; border: 1px solid var(--border); border-radius: 4px; background: #fff; cursor: pointer; font-family: inherit; }
  .help-body { font-size: 12.5px; line-height: 1.5; margin: 8px 0 14px; padding: 10px 12px; background: #f7f9fa; border-radius: 6px; }
  .help-body ol { margin: 0; padding-left: 18px; }
  .help-body li { margin-bottom: 4px; }
  .empty-state-steps { margin: 0; padding-left: 18px; font-size: 13px; color: #555; line-height: 1.5; }
  .empty-state-steps li { margin-bottom: 4px; }
  .info-icon {
    display: inline-block; font-size: 11px; color: var(--muted); cursor: help; margin-left: 2px;
  }
  .subtitle { font-size: 12px; color: var(--muted); margin-bottom: 14px; line-height:1.4; }
  .panel { margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px solid #f0f0f0; }
  .panel h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 0 0 8px; }
  .slider-row { display:flex; align-items:center; gap:8px; }
  .slider-row input[type=text] { flex: 1 1 auto; width: auto; }
  .slider-row button {
    flex: 0 0 auto; font-size: 13px; padding: 6px 12px; border: 1px solid var(--border);
    border-radius: 4px; background: #fff; cursor: pointer; font-family: inherit;
  }
  .slider-row button:hover { background: #f5f5f5; }
  input[type=range] { flex:1; }
  input[type=text] {
    width: 100%; box-sizing: border-box; padding: 6px 8px; font-size: 13px;
    border: 1px solid var(--border); border-radius: 4px;
  }
  .hint { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .radius-val { font-size: 13px; font-weight: 600; min-width: 52px; text-align:right; }
  .placeholder { color: var(--muted); font-size: 13px; }
  .loading { color: var(--muted); font-style: italic; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; }
  .spinner {
    display: inline-block; width: 12px; height: 12px; flex: 0 0 auto;
    border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
  .error-msg { color: #b3261e; font-size: 12px; }
  .stat-grid { display:grid; grid-template-columns: 1fr auto; gap: 3px 8px; font-size: 13px; }
  .stat-grid .k { color: #555; }
  .stat-grid .v { font-weight: 600; text-align:right; }
  .legend-item { display:flex; align-items:center; gap:7px; font-size:12px; margin-bottom:5px; }
  .legend-dot { width:11px; height:11px; border-radius:50%; display:inline-block; flex-shrink:0; }
  .legend-square { width:10px; height:10px; display:inline-block; background:#999999; flex-shrink:0; }
  .eq-info { font-size: 13px; line-height: 1.5; }
  .eq-info b { color: var(--accent); }
  footer { font-size: 11px; color: var(--muted); line-height: 1.5; }
  footer a { color: #1a5276; }
  .disclaimer { display: inline-block; margin-top: 6px; font-style: italic; }
  a { color: #1a5276; }
  .visually-hidden {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 700px) {
    #app { flex-direction: column; height: 100dvh; }
    #sidebar {
      width: 100%; flex: 0 0 auto; max-height: 45dvh; border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    #mapPane { min-height: 55dvh; }
    .legend-control { max-width: min(230px, calc(100vw - 30px)); }
    /* Bug (gevonden bij mobiel testen): de uitgeklapte legenda-body kon hoger worden dan de
       kaartpane zelf (55dvh) - Leaflet's control groeit dan omhoog voorbij de bovenkant van #map
       (overflow:hidden), waardoor zelfs de "Legenda"-knop zelf buiten het klikbare kaartgebied
       terechtkwam en niet meer te sluiten was. Vaste max-hoogte + scroll voorkomt dat. */
    .legend-control-body { max-height: 35dvh; overflow-y: auto; }
    #timebar { padding: 8px 10px; gap: 7px; }
    #timeYearLabel { min-width: 68px; }
  }
</style>
</head>
<body>
<div id="app">
  <div id="sidebar">
    <div class="logos-row">
      <svg class="brand-logo" width="40" height="40" viewBox="0 0 64 64" role="img" aria-label="Logo: Aardbevingen NL - epicentrum en rijksmonumenten">
        <title>Aardbevingen NL - epicentrum &amp; rijksmonumenten (eigen, onafhankelijk beeldmerk)</title>
        <rect x="2" y="2" width="60" height="60" rx="14" fill="none" stroke="var(--accent)" stroke-width="2.5"/>
        <polyline points="8,38 18,38 22,26 26,46 30,20 34,44 38,38 56,38" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M19 14 L26 20 L24 20 L24 28 L14 28 L14 20 L12 20 Z" fill="var(--accent)"/>
        <g transform="translate(40,32)">
          <line x1="4" y1="0" x2="4" y2="8" stroke="var(--accent)" stroke-width="1.6"/>
          <path d="M0 8 L8 8 L6.5 16 L4 17 L1.5 16 Z" fill="var(--accent)"/>
        </g>
      </svg>
    </div>
    <div class="title-row">
      <h1>Aardbevingen NL</h1>
      <button type="button" id="helpToggle" class="help-toggle" aria-expanded="false" aria-controls="helpBody">Hoe werkt deze kaart?</button>
    </div>
    <div class="subtitle">Epicentrum selecteren, straal instellen, rijksmonumenten binnen bereik zien. Aardbevingen rechtstreeks van het KNMI, rijksmonumenten via linked data van de RCE.</div>
    <div id="latestEqInfo" class="hint" aria-live="polite"></div>
    <div id="helpBody" class="help-body" style="display:none">
      <ol>
        <li>Selecteer een aardbeving op de kaart, of zoek op plaatsnaam.</li>
        <li>Kies een zoekstraal in kilometers.</li>
        <li>Bekijk de rijksmonumenten binnen dat gebied - de kleur is een verkennende
          impactindicatie, geen schadebeoordeling.</li>
      </ol>
    </div>

    <div class="panel">
      <h2>Zoek op plaats</h2>
      <label class="visually-hidden" for="placeSearch">Plaatsnaam</label>
      <input type="text" id="placeSearch" list="placeList" placeholder="bijv. Loppersum" autocomplete="off">
      <datalist id="placeList"></datalist>
      <div class="hint">Springt naar de meest recente aardbeving bij die plaatsnaam (uit het toponiem in de data).</div>
      <div id="placeStatus" class="hint" aria-live="polite"></div>
    </div>

    <div class="panel">
      <h2>Straal</h2>
      <div class="slider-row">
        <label class="visually-hidden" for="radiusSlider">Zoekstraal in kilometers</label>
        <input type="range" id="radiusSlider" min="1" max="200" value="25">
        <span class="radius-val" id="radiusVal">25 km</span>
      </div>
    </div>

    <div class="panel">
      <h2>Geselecteerd epicentrum</h2>
      <div id="selectedInfo">
        <ol class="empty-state-steps">
          <li>Selecteer een aardbeving op de kaart, of zoek op plaatsnaam.</li>
          <li>Kies een zoekstraal in kilometers.</li>
          <li>Bekijk de rijksmonumenten binnen dat gebied - de kleur is een verkennende
            impactindicatie, geen schadebeoordeling.</li>
        </ol>
      </div>
    </div>

    <div class="panel" id="nlogPanel">
      <h2>NLOG mijnbouw</h2>

      <label for="nlogOperatorFilter" class="hint" style="display:block;margin-bottom:4px;">Operator</label>
      <select id="nlogOperatorFilter" style="width:100%;box-sizing:border-box;padding:6px 8px;font-size:13px;border:1px solid var(--border);border-radius:4px;background:#fff;">
        <option value="all">Alle operators</option>
        <option value="nam">Alleen NAM</option>
      </select>

      <div style="margin-top:8px;">
        <label style="display:block;font-size:12px;margin-bottom:4px;">
          <input type="checkbox" id="nlogFieldsToggle" checked>
          Velden tonen
        </label>
        <label style="display:block;font-size:12px;">
          <input type="checkbox" id="nlogFacilitiesToggle">
          Mijnbouwlocaties tonen
        </label>
      </div>

      <div id="nlogStatus" class="hint" style="margin-top:6px;">NLOG-data laden…</div>
    </div>

    <div class="panel">
      <h2>Aardbevingen binnen straal</h2>
      <div id="eqStats" aria-live="polite"><span class="placeholder">—</span></div>
    </div>

    <div class="panel">
      <h2>Rijksmonumenten binnen straal</h2>
      <div id="monStatus" aria-live="polite"><span class="placeholder">—</span></div>
      <button type="button" id="downloadCsvBtn" class="download-btn">Download CSV</button>
    </div>

    <div class="panel" id="monumentFilterPanel" style="display:none">
      <h2>Filter op type / functie</h2>
      <div id="monumentFilterBody"></div>
    </div>

    <div class="panel">
      <h2>Zoek op rijksmonumentnummer</h2>
      <div class="slider-row">
        <label class="visually-hidden" for="monNrSearch">Rijksmonumentnummer</label>
        <input type="text" id="monNrSearch" inputmode="numeric" placeholder="bijv. 26265" autocomplete="off">
        <button type="button" id="monNrSearchBtn">Zoek</button>
        <button type="button" id="monNrResetBtn" title="Zoekresultaat wissen">Wis</button>
      </div>
      <div class="hint">Toont de locatie van dit rijksmonument en de dichtstbijzijnde aardbeving uit de volledige dataset (1911-heden).</div>
      <div id="monNrStatus" class="hint" aria-live="polite"></div>
    </div>

    <footer>
      Aardbevingen: <a href="https://rdsa.knmi.nl/abcws/event/query?eventtype=induced&format=csv" target="_blank" rel="noopener">KNMI</a> ·
      Rijksmonumenten: <a href="https://linkeddata.cultureelerfgoed.nl/def/ceo" target="_blank" rel="noopener">CEO / RCE CHO</a><br>
      Kaart: Leaflet + CARTO. Beide databronnen worden rechtstreeks bevraagd. De applicatie gebruikt geen ingebouwde momentopname.<br>
      <a href="achtergrond.html">Achtergrond: waarom aardbevingen en rijksmonumenten?</a><br>
      Applicatieversie 0.20.5<br>
      <span class="disclaimer">Onafhankelijk initiatief. Niet ontwikkeld in opdracht van KNMI of RCE. Aan deze kaart en de bijbehorende teksten kunnen geen rechten of plichten worden ontleend.</span>
    </footer>
  </div>
  <div id="mapPane">
    <div id="map"></div>
    <div id="timebar">
      <button id="timePlayBtn" type="button" title="Afspelen" aria-label="Afspelen">&#9654;</button>
      <div class="range-slider-wrap">
        <div class="range-track"></div>
        <div class="range-fill" id="rangeFill"></div>
        <label class="visually-hidden" for="timeSliderFrom">Eerste jaar van de tijdsselectie</label>
        <input type="range" id="timeSliderFrom" min="0" max="1" value="0">
        <label class="visually-hidden" for="timeSliderTo">Laatste jaar van de tijdsselectie</label>
        <input type="range" id="timeSliderTo" min="0" max="1" value="1">
      </div>
      <span id="timeYearLabel">—</span>
      <button id="timeResetBtn" type="button">toon alles</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
  "use strict";

  var MON_ENDPOINT = "https://api.linkeddata.cultureelerfgoed.nl/datasets/rce/cho/services/cho/sparql";
  var MONUMENTENREGISTER_URL = "https://monumentenregister.cultureelerfgoed.nl/monumenten/";

  // Aardbevingen en rijksmonument-impact gebruiken elk hun eigen kleurenschaal (geen overlap,
  // bv. niet allebei rood) zodat de twee betekenissen nooit door elkaar lopen op de kaart.
  // Het KNMI kent alleen "induced" en "tectonic" (geen aparte steengroeve-categorie); DEFAULT_COLOR
  // is puur een defensieve fallback en zou in de praktijk nooit gebruikt moeten worden.
  var CATEGORY_COLORS = {
    "geïnduceerde aardbevingen": "#f2c200",
    "tektonische aardbevingen": "#1d70a2"
  };
  var DEFAULT_COLOR = "#8b5e3c";
  var MARKER_STROKE = "#333333";
  var MONUMENT_STROKE = "#222222";
  var MONUMENT_COLOR_IN = "#c0392b";
  var MONUMENT_COLOR_NET = "#e67e22";
  // Kleurenblindheid-check (Machado et al. 2009-matrices, dezelfde als Chrome's eigen "Emulate
  // vision deficiencies"): het oorspronkelijke groen (#2e7d32) lag bij deuteranopie (de meest
  // voorkomende vorm) nagenoeg boven op rood (RGB-afstand 13 van de ~440 mogelijke) -- rood en
  // groen werden dus vrijwel identiek. Vervangen door Okabe & Ito's "bluish green" (#009E73, uit
  // hun veelgeciteerde kleurenblind-veilige palet), dat voor gewoon zicht nog steeds als "groen"
  // leest maar de rood/groen-afstand bij deuteranopie naar 78 en bij protanopie naar 115 brengt.
  var MONUMENT_COLOR_OUT = "#009E73";
  var MONUMENT_COLOR_UNKNOWN = "#999999";
  var MONUMENT_ICON_PX = 16; // vaste pixelgrootte, ECHT zoom-onafhankelijk (i.t.t. graden: een
  // rectangle van vaste graden-breedte krimpt bij uitzoomen tot onder 1 pixel en wordt onzichtbaar,
  // gevonden toen een monument op 60km straal wel in de resultaten stond maar niet te zien was)

  // Huisje voor "onroerend gebouwd", schop voor "archeologisch" -- vorm geeft het type aan,
  // vulkleur (rood/oranje/groen) blijft de effectgebied-score aangeven.
  function houseIconSvg(color) {
    return '<svg width="' + MONUMENT_ICON_PX + '" height="' + MONUMENT_ICON_PX + '" viewBox="0 0 16 16">' +
      '<path d="M8 1 L15 7 L13 7 L13 15 L3 15 L3 7 L1 7 Z" fill="' + color + '" stroke="' + MONUMENT_STROKE + '" stroke-width="1" stroke-linejoin="round"/>' +
      '</svg>';
  }

  function spadeIconSvg(color) {
    return '<svg width="' + MONUMENT_ICON_PX + '" height="' + MONUMENT_ICON_PX + '" viewBox="0 0 16 16">' +
      '<line x1="8" y1="1" x2="8" y2="9" stroke="' + MONUMENT_STROKE + '" stroke-width="1.5"/>' +
      '<path d="M4 8 L12 8 L10 15 L8 16 L6 15 Z" fill="' + color + '" stroke="' + MONUMENT_STROKE + '" stroke-width="1" stroke-linejoin="round"/>' +
      '</svg>';
  }

  // Paars, stippellijn-ring rond het icoon: puur informatief, los van de rood/oranje/groen-
  // impactindicatie en de geel/blauw-aardbevingscategorieen (geen van beide is paars), voor
  // rijksmonumenten die al in het officiele RCE-versterkingsprogramma zitten (optie A: laten zien
  // hoe de exploratieve straal-selectie van deze kaart zich verhoudt tot die vaste, beoordeelde lijst).
  var VERSTERKING_RING_COLOR = "#8e44ad";
  var VERSTERKING_RING_MARGIN = 8; // extra px rondom het bestaande 16px-icoon

  function monumentIconSvg(type, color, inVersterking) {
    var inner = type === "archeologisch" ? spadeIconSvg(color) : houseIconSvg(color);
    if (!inVersterking) return inner;
    var ringPx = MONUMENT_ICON_PX + VERSTERKING_RING_MARGIN;
    var half = VERSTERKING_RING_MARGIN / 2;
    return '<div style="position:relative;width:' + ringPx + 'px;height:' + ringPx + 'px;">' +
      '<svg width="' + ringPx + '" height="' + ringPx + '" viewBox="0 0 ' + ringPx + ' ' + ringPx + '" style="position:absolute;top:0;left:0;">' +
      '<circle cx="' + (ringPx / 2) + '" cy="' + (ringPx / 2) + '" r="' + (ringPx / 2 - 1.5) + '" fill="none" stroke="' + VERSTERKING_RING_COLOR + '" stroke-width="2" stroke-dasharray="3 2"/>' +
      '</svg>' +
      '<div style="position:absolute;top:' + half + 'px;left:' + half + 'px;">' + inner + '</div>' +
      '</div>';
  }

  // Rijksmonumentnummers uit de officiele RCE-versterkingslijst (kennis.cultureelerfgoed.nl,
  // "Aardbevingen - Lijst rijksmonumenten"), door de gebruiker aangeleverd. Snapshot, geen live
  // koppeling met die pagina -- kan achterlopen als de officiele lijst wijzigt.
  var VERSTERKINGSPROGRAMMA_NRS = new Set([
    "40294", "40295", "517382", "40298", "509407", "8214", "8224", "8253", "8255", "8228",
    "8226", "8229", "8230", "8242", "8227", "8262", "509404", "8245", "8247", "8578",
    "8728", "9465", "35005", "38271", "30918", "12315", "12328", "8582", "18752", "8871",
    "14548", "40300", "18761", "23460", "15547", "15553", "9780", "528913", "517357", "517377",
    "517399", "9469", "484088", "33807", "33809", "33810", "12325", "9474", "29897", "23456",
    "33811", "9479", "18755", "24000", "40301", "40302", "517383", "9784", "26265", "517391",
    "517355", "517354", "9480", "8252", "28421", "12326", "24004", "18758", "29894", "29921",
