  }

  // CEO-functienamen komen soms met een intern codeachtervoegsel, inconsistent met/zonder spatie
  // ervoor: "Boerderij (M1)", "Boerderij(M1)". Puur cosmetisch bij weergave -- ruwe data blijft
  // ongewijzigd, dit raakt alleen het label in de popup.
  function stripParenSuffix(label) {
    return label ? label.replace(/\s*\([^)]*\)/g, "").trim() : label;
  }

  async function fetchWithTimeout(url, options, timeoutMs) {
    var controller = new AbortController();
    var timer = setTimeout(function () { controller.abort(); }, timeoutMs || 20000);
    try {
      var requestOptions = Object.assign({}, options || {}, { signal: controller.signal });
      return await fetch(url, requestOptions);
    } catch (err) {
      if (err && err.name === "AbortError") {
        throw new Error("Verzoek duurde te lang en is afgebroken");
      }
      throw err;
    } finally {
      clearTimeout(timer);
    }
  }

  async function sparqlSelect(endpoint, query) {
    var url = endpoint + "?query=" + encodeURIComponent(query);
    var res = await fetchWithTimeout(url, { headers: { Accept: "application/sparql-results+json" } }, 20000);
    if (!res.ok) throw new Error("SPARQL-verzoek mislukt (" + res.status + ")");
    var json = await res.json();
    return json.results.bindings;
  }

  // Live rechtstreeks bij het KNMI, niet via RCE. Gevonden via de prov:wasDerivedFrom-triples op
  // RCE's eigen aardbevingen-graph, die naar exact deze twee endpoints wijzen -- RCE's dataset
  // is dus zelf een periodieke import hiervan. CORS bevestigd open (reflecteert elke Origin).
  // Dekking: 1911-heden (tektonisch) en 1986-heden (geinduceerd), bijgewerkt door het KNMI zelf.
  // Andere KNMI-bronnen afgewogen en verworpen: dataplatform.knmi.nl/aardbevingen_nederland is
  // beperkt tot de laatste 100 events (NetCDF); aardbevingen_cijfers zijn aggregaat-tellingen,
  // geen coordinaten per event.
  var KNMI_INDUCED_URL = "https://rdsa.knmi.nl/abcws/event/query?eventtype=induced&format=csv";
  var KNMI_TECTONIC_URL = "https://rdsa.knmi.nl/abcws/event/query?eventtype=tectonic&format=csv";

  // Gemeten (curl, drie herhalingen): het induced-endpoint kost bij een "koude" cache ~15,5s om
  // te antwoorden, tegen ~0,8s zodra de KNMI-server 'm net gecached heeft; het tectonic-endpoint
  // toont hetzelfde patroon maar minder uitgesproken (~7,2s koud, ~0,9s warm). Op een trager
  // netwerk/toestel kan die koude start het 20s-timeout overschrijden, waardoor alleen tectonic
  // rendert en de gebruiker leek te moeten verversen om de rest te krijgen. Twee maatregelen:
  // ruimere timeout (35s) en één automatische retry na een korte pauze, die in de praktijk de
  // inmiddels warme cache raakt -- zodat een handmatige refresh niet meer nodig zou moeten zijn.
  var KNMI_TIMEOUT_MS = 35000;
  var KNMI_RETRY_DELAY_MS = 1500;

  function delay(ms) {
    return new Promise(function (resolve) { setTimeout(resolve, ms); });
  }

  async function fetchKnmiCsv(url) {
    try {
      var res = await fetchWithTimeout(url, {}, KNMI_TIMEOUT_MS);
      if (!res.ok) throw new Error("KNMI-verzoek mislukt (" + res.status + ")");
      return await res.text();
    } catch (err) {
      // Eenmalige automatische herkansing bij een trage/koude eerste respons of afgebroken
      // verzoek, i.p.v. de gebruiker zelf te laten verversen.
      await delay(KNMI_RETRY_DELAY_MS);
      var retryRes = await fetchWithTimeout(url, {}, KNMI_TIMEOUT_MS);
      if (!retryRes.ok) throw new Error("KNMI-verzoek mislukt (" + retryRes.status + ")");
      return await retryRes.text();
    }
  }

  // CSV-kolommen: YYMMDD,TIME,LOCATION,LAT,LON,DEPTH,MAG,EVALMODE. LOCATION kan zelf een komma
  // bevatten (bv. "Oost-, West- en Middelbeers") -- de eerste 2 en laatste 5 velden liggen vast,
  // alles ertussen is de locatienaam, zo blijft die ene rij toch correct parsen.
  function parseKnmiCsv(text, category) {
    var lines = text.split(/\r?\n/).filter(function (l) { return l.trim().length > 0; });
    lines.shift(); // header
    return lines.map(function (line) {
      var f = line.split(",");
      var ymd = f[0], time = f[1];
      var lat = parseFloat(f[f.length - 5]);
      var lon = parseFloat(f[f.length - 4]);
      var depthValue = parseFloat(f[f.length - 3]);
      var magValue = parseFloat(f[f.length - 2]);
      var depth = Number.isFinite(depthValue) ? depthValue : null;
      var mag = Number.isFinite(magValue) ? magValue : null;
      var place = f.slice(2, f.length - 5).join(",");
      var iso = ymd.length === 8
        ? ymd.slice(0, 4) + "-" + ymd.slice(4, 6) + "-" + ymd.slice(6, 8) + "T" + time + "Z"
        : null;
      return { date: iso, place: place || null, lat: lat, lon: lon, depth: depth, mag: mag, category: category };
    }).filter(function (e) { return !isNaN(e.lat) && !isNaN(e.lon) && e.date !== null; });
  }

  // Concept-URI's geverifieerd tegen de live RCE-dataset (graph instanties-rce).
  var STATUS_RIJKSMONUMENT_URI = "https://data.cultureelerfgoed.nl/term/id/rn/2/b2d9a59a-fe1e-4552-9a05-3c2acddff864";
  var AARD_GEBOUWD_URI = "https://data.cultureelerfgoed.nl/term/id/rn/2/fc966a68-8863-4970-a83e-110f96006c21";
  var AARD_ARCHEOLOGISCH_URI = "https://data.cultureelerfgoed.nl/term/id/rn/2/b673c8c1-5d93-496d-8f9e-89133d579d77";
  var INSTANTIES_GRAPH = "https://linkeddata.cultureelerfgoed.nl/graph/instanties-rce";
  var GEBOUWD_LIMIT = 400;
  // Archeologische rijksmonumenten (o.a. scheepswrakken) zijn landelijk maar ~1.500 -- geen
  // praktische cap nodig. Apart bevraagd, want anders verdwijnen ze structureel uit de top-400
  // van de veel dichtere "onroerend gebouwd"-categorie (bevestigd: bij Anna Paulowna liggen 792
  // gebouwde monumenten dichterbij dan het scheepswrak "aanloop Molengat", dat daardoor nooit in
  // een LIMIT-400-resultaat terechtkwam, ook niet bij een straal die het ruim zou moeten dekken).
  var ARCHEOLOGISCH_LIMIT = 3000;

  function buildMonumentQuery(lon, lat, radiusM, aardUri, limit) {
    return 'PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>\n' +
      'PREFIX geo: <http://www.opengis.net/ont/geosparql#>\n' +
      'PREFIX geof: <http://www.opengis.net/def/function/geosparql/>\n' +
      'PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n' +
      'SELECT ?mon ?nr (SAMPLE(?wkt) AS ?wktSample) (MIN(?dist) AS ?minDist) (SAMPLE(?naam) AS ?naamOut) (SAMPLE(?funcOorspr) AS ?funcOorsprOut) (SAMPLE(?funcHuidig) AS ?funcHuidigOut) (SAMPLE(?aardLabel) AS ?aardOut) WHERE {\n' +
      '  ?mon a ceo:Rijksmonument ;\n' +
      '       ceo:rijksmonumentnummer ?nr ;\n' +
      '       ceo:heeftGeometrie ?geomNode .\n' +
      '  ?geomNode geo:asWKT ?wkt .\n' +
      '  BIND(geof:distance("POINT(' + lon + ' ' + lat + ')"^^geo:wktLiteral, ?wkt, <http://www.opengis.net/def/uom/OGC/1.0/metre>) AS ?dist)\n' +
      '  FILTER(?dist < ' + radiusM + ')\n' +
      // Alleen geldige (actuele) rijksmonumenten: juridische status en monumentaard leven in de
      // graph instanties-rce; zonder deze GRAPH-restrictie riskeert de query dubbeltellingen.
      '  GRAPH <' + INSTANTIES_GRAPH + '> {\n' +
      '    ?mon ceo:heeftJuridischeStatus <' + STATUS_RIJKSMONUMENT_URI + '> ;\n' +
      '         ceo:heeftMonumentAard <' + aardUri + '> .\n' +
      '    OPTIONAL { ?mon ceo:heeftMonumentAard ?aardUri2 . ?aardUri2 skos:prefLabel ?aardLabel }\n' +
      '  }\n' +
      '  OPTIONAL { ?mon ceo:heeftNaam ?naamObj . ?naamObj ceo:naam ?naam }\n' +
      // Oorspronkelijke functie is de primaire weergave (bij ~100% van de geldige rijksmonumenten gevuld);
      // huidige functie wordt er apart naast getoond wanneer aanwezig (bij ~8% het geval), niet als vervanging.
      '  OPTIONAL { ?mon ceo:heeftHuidigeFunctie ?funcObjH . ?funcObjH ceo:heeftFunctieNaam ?funcCH . ?funcCH skos:prefLabel ?funcHuidig . FILTER(LANG(?funcHuidig) = "nl") }\n' +
      '  OPTIONAL { ?mon ceo:heeftOorspronkelijkeFunctie ?funcObjO . ?funcObjO ceo:heeftFunctieNaam ?funcCO . ?funcCO skos:prefLabel ?funcOorspr . FILTER(LANG(?funcOorspr) = "nl") }\n' +
      '}\n' +
      'GROUP BY ?mon ?nr\n' +
      'ORDER BY ?minDist\n' +
      'LIMIT ' + limit;
  }

  // Rijksmonumentnummer-opzoeking (geen afstandsfilter, geen vaste aard vooraf -- de aard-URI
  // wordt zelf opgehaald om te bepalen of het icoon een huisje of schop moet zijn). ceo:rijksmonu-
  // mentnummer is xsd:string, niet xsd:integer (bevestigd in de rce-cho ontologiedocumentatie) --
  // de aanroeper valideert vooraf met /^\d+$/ zodat hier nooit ongevalideerde tekst instroomt.
  function buildMonumentByNumberQuery(nr) {
    return 'PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>\n' +
      'PREFIX geo: <http://www.opengis.net/ont/geosparql#>\n' +
      'PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n' +
      'SELECT ?mon ?nr (SAMPLE(?wkt) AS ?wktSample) (SAMPLE(?naam) AS ?naamOut) (SAMPLE(?funcOorspr) AS ?funcOorsprOut) (SAMPLE(?funcHuidig) AS ?funcHuidigOut) (SAMPLE(?aardLabel) AS ?aardOut) (SAMPLE(?aardUri) AS ?aardUriOut) WHERE {\n' +
      '  ?mon a ceo:Rijksmonument ;\n' +
      '       ceo:rijksmonumentnummer "' + nr + '" ;\n' +
      '       ceo:heeftGeometrie ?geomNode .\n' +
      // ?nr matcht op de letterlijke waarde (?mon ceo:rijksmonumentnummer "..") maar wordt daar
      // zelf niet door gebonden -- expliciet BIND'en, anders ontbreekt ?nr in elke oplossing
      // (gevonden tijdens testen: b.nr was undefined in elke binding zonder deze regel).
      '  BIND("' + nr + '" AS ?nr)\n' +
      '  ?geomNode geo:asWKT ?wkt .\n' +
      '  GRAPH <' + INSTANTIES_GRAPH + '> {\n' +
      '    ?mon ceo:heeftJuridischeStatus <' + STATUS_RIJKSMONUMENT_URI + '> ;\n' +
      '         ceo:heeftMonumentAard ?aardUri .\n' +
      '    ?aardUri skos:prefLabel ?aardLabel .\n' +
      '  }\n' +
      '  OPTIONAL { ?mon ceo:heeftNaam ?naamObj . ?naamObj ceo:naam ?naam }\n' +
      '  OPTIONAL { ?mon ceo:heeftHuidigeFunctie ?funcObjH . ?funcObjH ceo:heeftFunctieNaam ?funcCH . ?funcCH skos:prefLabel ?funcHuidig . FILTER(LANG(?funcHuidig) = "nl") }\n' +
      '  OPTIONAL { ?mon ceo:heeftOorspronkelijkeFunctie ?funcObjO . ?funcObjO ceo:heeftFunctieNaam ?funcCO . ?funcCO skos:prefLabel ?funcOorspr . FILTER(LANG(?funcOorspr) = "nl") }\n' +
      '}\n' +
      'GROUP BY ?mon ?nr\n' +
      'LIMIT 5';
  }

  function mapMonumentByNumberBindings(bindings) {
    return bindings.map(function (b) {
      var pt = parseFirstLonLat(b.wktSample.value);
      var aardUri = b.aardUriOut ? b.aardUriOut.value : null;
      return {
        uri: b.mon.value,
        nr: b.nr.value,
        lat: pt ? pt.lat : null,
        lon: pt ? pt.lon : null,
        naam: b.naamOut ? b.naamOut.value : null,
        functieOorspr: b.funcOorsprOut ? b.funcOorsprOut.value : null,
        functieHuidig: b.funcHuidigOut ? b.funcHuidigOut.value : null,
        aard: b.aardOut ? b.aardOut.value : null,
        type: aardUri === AARD_ARCHEOLOGISCH_URI ? "archeologisch" : "gebouwd",
        distKm: null
      };
    }).filter(function (m) { return m.lat !== null; });
  }

  function nlogProp(properties, candidates) {
    if (!properties) return null;
    var keys = Object.keys(properties);
    for (var i = 0; i < candidates.length; i++) {
      var wanted = candidates[i].toLowerCase();
      for (var j = 0; j < keys.length; j++) {
        if (keys[j].toLowerCase() === wanted) {
          var value = properties[keys[j]];
          if (value !== null && value !== undefined && String(value).trim() !== "") return value;
        }
      }
    }
    return null;
  }

  function nlogFieldKind(properties) {
    var raw = [
      nlogProp(properties, ["RESULT"]),
      nlogProp(properties, ["FIELD_TYPE"]),
      nlogProp(properties, ["TYPE"])
    ].filter(Boolean).join(" ").toLowerCase();

    if (raw.indexOf("gas") >= 0) return "gas";
    if (raw.indexOf("olie") >= 0 || raw.indexOf("oil") >= 0) return "oil";
    if (raw.indexOf("geother") >= 0 || raw.indexOf("aardwarm") >= 0) return "geothermal";
    if (raw.indexOf("opslag") >= 0 || raw.indexOf("storage") >= 0) return "storage";
    return "other";
  }

  function styleNlogField(feature) {
    var kind = nlogFieldKind((feature && feature.properties) || {});
    var styles = {
      gas:        { color: "#6f5b3e", fillColor: "#c9b27c" },
      oil:        { color: "#4d4d4d", fillColor: "#8a8a8a" },
      geothermal: { color: "#2f6f73", fillColor: "#7fb3b5" },
      storage:    { color: "#6b5a7a", fillColor: "#a995b8" },
      other:      { color: "#777777", fillColor: "#b8b8b8" }
    };
    var s = styles[kind] || styles.other;
    return {
      color: s.color,
      weight: 1.2,
      opacity: 0.85,
      fillColor: s.fillColor,
      fillOpacity: 0.18
    };
  }

  function nlogPopupRows(properties, rows) {
    return rows.map(function (row) {
      var value = nlogProp(properties, row.keys);
      return value === null ? "" : escapeHtml(row.label) + ": " + escapeHtml(value) + "<br>";
    }).join("");
  }

  function bindNlogFieldPopup(feature, layer) {
    var p = feature.properties || {};
    var name = nlogProp(p, ["FIELD_NAME", "FIELDNAME", "NAME", "VELD_NAAM", "VELDNAAM"]) || "NLOG-veld";
    layer.bindPopup(
      '<div class="eq-info">' +
      "<b>" + escapeHtml(name) + "</b><br>" +
      nlogPopupRows(p, [
        { label: "Type", keys: ["RESULT", "FIELD_TYPE", "TYPE"] },
        { label: "Status", keys: ["STATUS", "FIELD_STATUS"] },
        { label: "Operator", keys: ["OPERATOR", "OPERATOR_NAME"] },
        { label: "Ontdekking", keys: ["DISCOVERY", "DISCOVERY_DATE"] },
        { label: "Start productie", keys: ["START_DATE", "PRODUCTION_START"] }
      ]) +
      '<a href="' + NLOG_SOURCE_URL + '" target="_blank" rel="noopener">Bron: NLOG</a>' +
      "</div>"
    );
  }

  function bindNlogFacilityPopup(feature, layer) {
    var p = feature.properties || {};
    var name = nlogProp(p, ["FACILITY_NAME", "FACILITY", "NAME", "LOCATION_NAME", "LOC_NAME", "INSTALLATION"]) || "Mijnbouwlocatie";
    layer.bindPopup(
      '<div class="eq-info">' +
      "<b>" + escapeHtml(name) + "</b><br>" +
      nlogPopupRows(p, [
        { label: "Type", keys: ["FACILITY_TYPE", "TYPE", "RESULT"] },
        { label: "Status", keys: ["STATUS", "FACILITY_STATUS"] },
        { label: "Operator", keys: ["OPERATOR", "OPERATOR_NAME"] }
      ]) +
      '<a href="' + NLOG_SOURCE_URL + '" target="_blank" rel="noopener">Bron: NLOG</a>' +
      "</div>"
    );
  }

  function isNamFeature(feature) {
    var operator = nlogProp((feature && feature.properties) || {}, ["OPERATOR", "OPERATOR_NAME"]);
    if (!operator) return false;
    var s = String(operator).toLowerCase();
    return s.indexOf("nederlandse aardolie maatschappij") >= 0 ||
           s === "nam" ||
           s.indexOf("nam b.v.") >= 0 ||
           s.indexOf("nam bv") >= 0;
  }

  function filterNlogFeatures(features) {
    if (state.nlogOperatorFilter !== "nam") return features;
    return features.filter(isNamFeature);
  }

  function renderNlogLayers() {
    var fields = filterNlogFeatures(state.nlogFields);
    var facilities = filterNlogFeatures(state.nlogFacilities);

    nlogFieldLayer.clearLayers();
    nlogFieldLayer.addData({ type: "FeatureCollection", features: fields });

    nlogFacilityLayer.clearLayers();
    nlogFacilityLayer.addData({ type: "FeatureCollection", features: facilities });

    if (state.nlogShowFields) {
      if (!map.hasLayer(nlogFieldLayer)) map.addLayer(nlogFieldLayer);
    } else if (map.hasLayer(nlogFieldLayer)) {
      map.removeLayer(nlogFieldLayer);
    }

    if (state.nlogShowFacilities) {
      if (!map.hasLayer(nlogFacilityLayer)) map.addLayer(nlogFacilityLayer);
    } else if (map.hasLayer(nlogFacilityLayer)) {
      map.removeLayer(nlogFacilityLayer);
    }

    var statusEl = $("nlogStatus");
    if (statusEl) {
      var label = state.nlogOperatorFilter === "nam" ? "NAM" : "alle operators";
      statusEl.textContent = fields.length + " velden en " + facilities.length + " mijnbouwlocaties (" + label + ").";
    }
  }

  function initNlogControls() {
    var select = $("nlogOperatorFilter");
    var fieldsToggle = $("nlogFieldsToggle");
    var facilitiesToggle = $("nlogFacilitiesToggle");

    if (select) {
      select.value = state.nlogOperatorFilter;
      select.addEventListener("change", function () {
        state.nlogOperatorFilter = select.value;
        renderNlogLayers();
      });
    }
    if (fieldsToggle) {
      fieldsToggle.checked = state.nlogShowFields;
      fieldsToggle.addEventListener("change", function () {
        state.nlogShowFields = fieldsToggle.checked;
        renderNlogLayers();
      });
    }
    if (facilitiesToggle) {
      facilitiesToggle.checked = state.nlogShowFacilities;
      facilitiesToggle.addEventListener("change", function () {
        state.nlogShowFacilities = facilitiesToggle.checked;
        renderNlogLayers();
      });
    }
  }

  var nlogResolvedTypeNames = null;

  async function resolveNlogTypeNames() {
    if (nlogResolvedTypeNames) return nlogResolvedTypeNames;

    var params = new URLSearchParams({
      service: "WFS",
      version: "2.0.0",
      request: "GetCapabilities"
    });

    var res = await fetchWithTimeout(
      NLOG_WFS_ENDPOINT + "?" + params.toString(),
      { headers: { Accept: "application/xml,text/xml,*/*" } },
      30000
    );

    if (!res.ok) throw new Error("NLOG GetCapabilities mislukt (" + res.status + ")");

    var xmlText = await res.text();
    var xml = new DOMParser().parseFromString(xmlText, "application/xml");
    if (xml.querySelector("parsererror")) throw new Error("NLOG GetCapabilities gaf ongeldige XML");

    var names = Array.from(xml.getElementsByTagNameNS("*", "FeatureType")).map(function (ft) {
      var nameEl = ft.getElementsByTagNameNS("*", "Name")[0];
      return nameEl ? nameEl.textContent.trim() : "";
    }).filter(Boolean);

    function findType(suffix, fallback) {
      var wanted = suffix.toLowerCase();
      var match = names.find(function (name) {
        var low = name.toLowerCase();
        return low === wanted || low.endsWith(":" + wanted);
      });
      return match || fallback;
    }

    nlogResolvedTypeNames = {
      field: findType("gdw_ng_field_utm", NLOG_FIELD_TYPENAME),
      facility: findType("gdw_ng_facility_utm", NLOG_FACILITY_TYPENAME)
    };

    console.info("NLOG WFS-laagnamen:", nlogResolvedTypeNames);
    return nlogResolvedTypeNames;
  }

  function buildNlogWfsUrl(typeName, version) {
    version = version || "2.0.0";
    var params = new URLSearchParams({
      service: "WFS",
      version: version,
      request: "GetFeature",
      outputFormat: "application/json",
      srsName: "EPSG:4326"
    });

    // WFS 2.0 gebruikt typeNames; WFS 1.1 gebruikt typeName.
    if (version === "2.0.0") params.set("typeNames", typeName);
    else params.set("typeName", typeName);

    return NLOG_WFS_ENDPOINT + "?" + params.toString();
  }

  async function fetchNlogGeoJson(typeName) {
    var attempts = ["2.0.0", "1.1.0"];
    var lastError = null;

    for (var i = 0; i < attempts.length; i++) {
      var version = attempts[i];
      try {
        var res = await fetchWithTimeout(
          buildNlogWfsUrl(typeName, version),
          { headers: { Accept: "application/geo+json, application/json,*/*" } },
          45000
        );

        var body = await res.text();

        if (!res.ok) {
          throw new Error("HTTP " + res.status + " via WFS " + version + ": " + body.slice(0, 180));
        }

        var json;
        try {
          json = JSON.parse(body);
        } catch (e) {
          throw new Error("geen GeoJSON via WFS " + version + ": " + body.slice(0, 180));
        }

        if (!json || json.type !== "FeatureCollection" || !Array.isArray(json.features)) {
          throw new Error("onverwacht GeoJSON-formaat via WFS " + version);
        }

        console.info("NLOG " + typeName + ": " + json.features.length + " features via WFS " + version);
        return json;
      } catch (err) {
        lastError = err;
        console.warn("NLOG poging mislukt voor " + typeName + " via WFS " + version + ":", err);
      }
    }

    throw lastError || new Error("NLOG-laag kon niet worden geladen");
  }

  async function loadNlogLayers() {
    var statusEl = $("nlogStatus");
    if (statusEl) statusEl.textContent = "NLOG-laagnamen bepalen…";

    var typeNames;
    try {
      typeNames = await resolveNlogTypeNames();
    } catch (err) {
      // GetCapabilities mag de data niet blokkeren. Val terug op bekende laagnamen.
      console.warn("NLOG GetCapabilities niet beschikbaar; bekende laagnamen worden gebruikt:", err);
      typeNames = {
        field: NLOG_FIELD_TYPENAME,
        facility: NLOG_FACILITY_TYPENAME
      };
    }

    if (statusEl) statusEl.textContent = "NLOG-data laden…";

    var results = await Promise.allSettled([
      fetchNlogGeoJson(typeNames.field),
      fetchNlogGeoJson(typeNames.facility)
    ]);

    state.nlogFields = results[0].status === "fulfilled"
      ? (results[0].value.features || [])
      : [];

    state.nlogFacilities = results[1].status === "fulfilled"
      ? (results[1].value.features || [])
      : [];

    var errors = [];

    if (results[0].status !== "fulfilled") {
      console.error("NLOG-velden konden niet worden geladen:", results[0].reason);
      errors.push("velden: " + (results[0].reason && results[0].reason.message ? results[0].reason.message : "onbekende fout"));
    }

    if (results[1].status !== "fulfilled") {
      console.error("NLOG-mijnbouwlocaties konden niet worden geladen:", results[1].reason);
      errors.push("mijnbouwlocaties: " + (results[1].reason && results[1].reason.message ? results[1].reason.message : "onbekende fout"));
    }

    renderNlogLayers();

    if (statusEl && errors.length) {
      var loadedText = state.nlogFields.length + " velden, " + state.nlogFacilities.length + " mijnbouwlocaties.";
      statusEl.innerHTML =
        escapeHtml(loadedText) +
        '<br><span class="error-msg">NLOG-fout: ' + escapeHtml(errors.join(" | ")) + "</span>";
    } else if (statusEl && state.nlogFacilities.length === 0) {
      statusEl.innerHTML =
        escapeHtml(state.nlogFields.length + " velden geladen.") +
        '<br><span class="error-msg">Let op: de facility-laag gaf 0 objecten terug.</span>';
    }
  }

  function initMap() {
    map = L.map("map", { center: [52.2, 5.3], zoom: 8 });
    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
      attribution: '&copy; <a href="https://carto.com/attributions">CARTO</a> &copy; OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(map);

    nlogFieldLayer = L.geoJSON(null, {
      style: styleNlogField,
      onEachFeature: bindNlogFieldPopup
    }).addTo(map);

    nlogFacilityLayer = L.geoJSON(null, {
      pointToLayer: function (feature, latlng) {
        return L.circleMarker(latlng, {
          radius: 7,
          color: "#ffffff",
          weight: 2.5,
          fillColor: "#d81b60",
          fillOpacity: 1,
          pane: "markerPane"
        });
      },
      onEachFeature: bindNlogFacilityPopup
    });

    eqLayer = L.layerGroup().addTo(map);
    monLayer = L.layerGroup().addTo(map);
    // Aparte laag voor de rijksmonumentnummer-opzoeking: blijft zichtbaar ongeacht straal-
    // wijzigingen elders (die alleen monLayer legen via renderMonuments()).
    monSearchLayer = L.layerGroup().addTo(map);
  }

  // Toont de meest recente beving uit de volledige dataset (niet beperkt door de tijdslider),
  // zodat direct zichtbaar is hoe actueel de live KNMI-data is.
  function renderLatestEqInfo(events) {
    var el = $("latestEqInfo");
    if (!events.length) { el.textContent = ""; return; }
    var latest = events.reduce(function (a, b) {
      return new Date(b.date) - new Date(a.date) > 0 ? b : a;
    });
    var dateStr = latest.date ? new Date(latest.date).toLocaleDateString("nl-NL") : "onbekende datum";
    el.textContent = "Laatst geregistreerde beving: " + dateStr +
      (latest.mag !== null ? " · M" + latest.mag.toFixed(1) : "") +
      (latest.place ? " bij " + latest.place : "");
  }

  async function loadEarthquakes() {
    $("eqStats").innerHTML = loadingHtml("Aardbevingen laden…");
    try {
      var results = await Promise.allSettled([
        fetchKnmiCsv(KNMI_INDUCED_URL),
        fetchKnmiCsv(KNMI_TECTONIC_URL)
      ]);
      var events = [];
      var warnings = [];

      if (results[0].status === "fulfilled") {
        events = events.concat(parseKnmiCsv(results[0].value, "geïnduceerde aardbevingen"));
      } else {
        warnings.push("geïnduceerde aardbevingen");
      }
      if (results[1].status === "fulfilled") {
        events = events.concat(parseKnmiCsv(results[1].value, "tektonische aardbevingen"));
      } else {
        warnings.push("tektonische aardbevingen");
      }
      if (!events.length) throw new Error("Geen van beide KNMI-bronnen kon worden geladen");

      state.events = events;
      renderLatestEqInfo(state.events);
      var years = state.events.map(function (e) { return yearOf(e.date); }).filter(function (y) { return y !== null; });
      state.minYear = years.length ? Math.min.apply(null, years) : null;
      state.maxYear = years.length ? Math.max.apply(null, years) : null;
      initTimeSlider();
      renderEarthquakeMarkers();
      populatePlaceList();

      var status = 'Selecteer een epicentrum om statistieken te zien.';
      if (warnings.length) status += ' Let op: niet geladen: ' + warnings.join(" en ") + '.';
      $("eqStats").innerHTML = '<span class="placeholder">' + escapeHtml(status) + '</span>';
    } catch (err) {
      $("eqStats").innerHTML = '<span class="error-msg" role="alert">Kon aardbevingsdata niet laden: ' + escapeHtml(err.message) + '</span>';
    }
  }

  function addEarthquakeMarker(ev, fillOpacity, strokeOpacity) {
    var radius = ev.mag !== null ? Math.max(3, ev.mag * 2.2) : 3;
    var marker = L.circleMarker([ev.lat, ev.lon], {
      radius: radius,
      color: MARKER_STROKE,
      fillColor: colorForCategory(ev.category),
      fillOpacity: fillOpacity,
      opacity: strokeOpacity,
      weight: 1
    });
    marker.__ev = ev; // bewaard voor updateEarthquakeFade(), zodat bestaande markers hun eigen
                      // event kunnen herkennen zonder de hele laag opnieuw te hoeven opbouwen
    var dateStr = ev.date ? new Date(ev.date).toLocaleDateString("nl-NL") : "onbekende datum";
    marker.bindTooltip(dateStr + (ev.mag !== null ? " · M" + ev.mag : ""));
    marker.bindPopup(
      '<div class="eq-info">' +
      '<b>' + (ev.place ? escapeHtml(ev.place) : "Onbekend toponiem") + '</b><br>' +
      dateStr + (ev.date ? " " + new Date(ev.date).toLocaleTimeString("nl-NL") : "") + '<br>' +
      'Magnitude: ' + (ev.mag !== null ? ev.mag.toFixed(1) + " ML" : "onbekend") + '<br>' +
      'Diepte: ' + (ev.depth !== null ? ev.depth + " km" : "onbekend") + '<br>' +
      (ev.category ? escapeHtml(ev.category) : "categorie onbekend") +
      '</div>'
    );
    marker.on("click", function () { selectEpicenter(ev.lat, ev.lon, ev.mag, ev.depth, ev.place, ev); });
    marker.addTo(eqLayer);
    return marker;
  }

  function renderEarthquakeMarkers() {
    eqLayer.clearLayers();
    var visible = state.timeFrom === null ? state.events : state.events.filter(function (ev) {
      var y = yearOf(ev.date);
      return y !== null && y >= state.timeFrom && y <= state.timeTo;
    });
    var hasSelection = !!(state.selected && state.selected.sourceEvent);
    // Bij een actieve selectie faden de overige bevingen (fillOpacity/opacity omlaag) i.p.v. de
    // geselecteerde apart te markeren -- voorkomt dat dichte clusters (Groningen, Limburg) de
    // gekozen beving overschreeuwen. De geselecteerde wordt als laatste getekend, dus zichtbaar
    // bovenop de gefade cluster. Alleen gebruikt bij een volledige heropbouw (initieel laden,
    // tijdslider-wijziging -- de zichtbare verzameling verandert dan echt); een kale
    // selectie-wijziging gebruikt updateEarthquakeFade() zodat bestaande markers (en een eventueel
    // al geopende popup) niet vernietigd worden.
    var selectedEv = null;
    visible.forEach(function (ev) {
      if (hasSelection && ev === state.selected.sourceEvent) { selectedEv = ev; return; }
      addEarthquakeMarker(ev, hasSelection ? 0.15 : 0.85, hasSelection ? 0.25 : 1);
    });
    if (selectedEv) addEarthquakeMarker(selectedEv, 0.85, 1);
  }

  // Bug (gevonden bij hands-on gebruik): renderEarthquakeMarkers() vanuit selectEpicenter()
  // aanroepen deed eqLayer.clearLayers() bij elke klik, wat de zojuist door Leaflet's eigen
  // click-to-open-popup geopende popup meteen weer vernietigde (nieuwe marker-instantie, popup
  // dus dicht) -- de aardbeving-popup "verdween". Fix: bestaande markers alleen van stijl
  // veranderen (setStyle + bringToFront), niet opnieuw aanmaken.
  function updateEarthquakeFade() {
    var hasSelection = !!(state.selected && state.selected.sourceEvent);
    eqLayer.eachLayer(function (marker) {
      var isSelected = hasSelection && marker.__ev === state.selected.sourceEvent;
      marker.setStyle({
        fillOpacity: isSelected || !hasSelection ? 0.85 : 0.15,
        opacity: isSelected || !hasSelection ? 1 : 0.25
      });
      if (isSelected) marker.bringToFront();
    });
  }

  function selectEpicenter(lat, lon, mag, depth, place, sourceEvent) {
    state.selected = {
      lat: lat, lon: lon,
      mag: mag === undefined ? null : mag,
      depth: depth === undefined ? null : depth,
      place: place || null,
      sourceEvent: sourceEvent || null
    };
    state.monumentFilter = null; // een nieuw epicentrum begint weer met de volledige lijst
    drawRadiusCircle();
    renderSelectedInfo();
    renderEqStats();
    updateEarthquakeFade();
    fetchMonumentsDebounced();
  }

  function drawRadiusCircle() {
    if (radiusCircle) { map.removeLayer(radiusCircle); }
    if (!state.selected) return;
    radiusCircle = L.circle([state.selected.lat, state.selected.lon], {
      radius: state.radiusKm * 1000,
      color: "#2c3e50",
      weight: 1.5,
      dashArray: "6 6",
      fill: false
    }).addTo(map);
    // Automatisch in-/uitzoomen op de straal-cirkel, zodat de gebruiker niet meer zelf hoeft te
    // zoomen na een selectie of straal-wijziging. maxZoom voorkomt een absurd ver ingezoomde
    // weergave bij een straal van maar 1 km.
    map.fitBounds(radiusCircle.getBounds(), { padding: [20, 20], maxZoom: 16 });
  }

  var EMPTY_STATE_STEPS_HTML =
    '<ol class="empty-state-steps">' +
    '<li>Selecteer een aardbeving op de kaart, of zoek op plaatsnaam.</li>' +
    '<li>Kies een zoekstraal in kilometers.</li>' +
    '<li>Bekijk de rijksmonumenten binnen dat gebied - de kleur is een verkennende ' +
    'impactindicatie, geen schadebeoordeling.</li>' +
    '</ol>';

  function renderSelectedInfo() {
    if (!state.selected) {
      $("selectedInfo").innerHTML = EMPTY_STATE_STEPS_HTML;
      return;
    }
    $("selectedInfo").innerHTML =
      '<div class="eq-info"><b>' + (state.selected.place ? escapeHtml(state.selected.place) : state.selected.lat.toFixed(4) + ', ' + state.selected.lon.toFixed(4)) + '</b><br>' +
      (state.selected.mag !== null ? 'Magnitude: ' + state.selected.mag.toFixed(1) + ' ML · ' : '') +
      (state.selected.depth !== null ? 'Diepte: ' + state.selected.depth + ' km' : '') +
      '</div>';
  }

  function renderEqStats() {
    if (!state.selected) return;
    var lat = state.selected.lat, lon = state.selected.lon, r = state.radiusKm;
    var inRange = state.events.filter(function (ev) {
      return haversineKm(lat, lon, ev.lat, ev.lon) <= r;
    });
    if (inRange.length === 0) {
      $("eqStats").innerHTML = '<span class="placeholder">Geen aardbevingen binnen ' + r + ' km.</span>';
      return;
    }
    var mags = inRange.filter(function (e) { return e.mag !== null; }).map(function (e) { return e.mag; });
    var avgMag = mags.length ? (mags.reduce(function (a, b) { return a + b; }, 0) / mags.length) : null;
    var maxMag = mags.length ? Math.max.apply(null, mags) : null;

    var perCat = {};
    inRange.forEach(function (e) {
      var key = e.category || "onbekend";
      perCat[key] = (perCat[key] || 0) + 1;
    });

    var rows = '<div class="stat-grid">' +
      '<div class="k">Aantal</div><div class="v">' + inRange.length + '</div>' +
      '<div class="k">Gem. magnitude</div><div class="v">' + (avgMag !== null ? avgMag.toFixed(2) : "—") + '</div>' +
      '<div class="k">Max. magnitude</div><div class="v">' + (maxMag !== null ? maxMag.toFixed(1) : "—") + '</div>' +
      '</div>';

    rows += '<div style="margin-top:8px;">' + Object.keys(perCat).map(function (k) {
      return '<div class="legend-item"><span class="legend-dot" style="background:' + colorForCategory(k === "onbekend" ? null : k) + '"></span>' +
        escapeHtml(k) + ': ' + perCat[k] + '</div>';
    }).join("") + '</div>';

    $("eqStats").innerHTML = rows;
  }

  var monDebounceTimer = null;
  function fetchMonumentsDebounced() {
    if (monDebounceTimer) clearTimeout(monDebounceTimer);
    monDebounceTimer = setTimeout(fetchMonuments, 350);
  }

  function mapMonumentBindings(bindings) {
    return bindings.map(function (b) {
      var pt = parseFirstLonLat(b.wktSample.value);
      return {
        uri: b.mon.value,
        nr: b.nr.value,
        lat: pt ? pt.lat : null,
        lon: pt ? pt.lon : null,
        naam: b.naamOut ? b.naamOut.value : null,
        functieOorspr: b.funcOorsprOut ? b.funcOorsprOut.value : null,
        functieHuidig: b.funcHuidigOut ? b.funcHuidigOut.value : null,
        aard: b.aardOut ? b.aardOut.value : null,
        distKm: b.minDist ? parseFloat(b.minDist.value) / 1000 : null
      };
    }).filter(function (m) { return m.lat !== null; });
  }

  async function fetchMonuments() {
    if (!state.selected) return;
    var token = ++state.monFetchToken;
    $("monStatus").innerHTML = loadingHtml("Rijksmonumenten ophalen…");
    try {
      var radiusM = state.radiusKm * 1000;
      var lon = state.selected.lon, lat = state.selected.lat;
      // Twee aparte queries: "onroerend gebouwd" is te dicht bevolkt voor een ongelimiteerde
      // ORDER BY dist, maar juist daardoor verdringt het de veel schaarsere archeologische
      // monumenten (o.a. scheepswrakken) structureel uit een gedeelde top-400 -- zie commentaar
      // bij buildMonumentQuery. Apart bevragen voorkomt dat.
      var gebouwdQuery = buildMonumentQuery(lon, lat, radiusM, AARD_GEBOUWD_URI, GEBOUWD_LIMIT);
      var archeologischQuery = buildMonumentQuery(lon, lat, radiusM, AARD_ARCHEOLOGISCH_URI, ARCHEOLOGISCH_LIMIT);
      var results = await Promise.allSettled([
        sparqlSelect(MON_ENDPOINT, gebouwdQuery),
        sparqlSelect(MON_ENDPOINT, archeologischQuery)
      ]);
      if (token !== state.monFetchToken) return;

      var gebouwd = results[0].status === "fulfilled" ? mapMonumentBindings(results[0].value) : [];
      var archeologisch = results[1].status === "fulfilled" ? mapMonumentBindings(results[1].value) : [];
      var warnings = [];
      if (results[0].status !== "fulfilled") warnings.push("gebouwde monumenten konden niet worden opgehaald");
      if (results[1].status !== "fulfilled") warnings.push("archeologische monumenten konden niet worden opgehaald");
      if (!gebouwd.length && !archeologisch.length && warnings.length === 2) {
        throw new Error("Beide monumentenverzoeken zijn mislukt");
      }

      // Type direct meegeven vanuit de query-batch (i.p.v. later op aardLabel-tekst te matchen) --
      // ondubbelzinnig, want elke batch is al gefilterd op precies één ceo:heeftMonumentAard-URI.
      gebouwd.forEach(function (m) { m.type = "gebouwd"; });
      archeologisch.forEach(function (m) { m.type = "archeologisch"; });
      var monuments = gebouwd.concat(archeologisch);
      state.lastMonuments = monuments;
      applyMonumentFilter();

      var gebouwdTekst = gebouwd.length >= GEBOUWD_LIMIT
        ? 'minstens ' + GEBOUWD_LIMIT + ' onroerend gebouwd; alleen de ' + GEBOUWD_LIMIT + ' dichtstbijzijnde getoond'
        : gebouwd.length + ' onroerend gebouwd';
      var status = '<span class="eq-info"><b>' + monuments.length + '</b> rijksmonument' +
        (monuments.length === 1 ? '' : 'en') + ' getoond binnen ' + state.radiusKm + ' km (' +
        gebouwdTekst + '; ' + archeologisch.length + ' archeologisch)';
      if (warnings.length) status += '. Let op: ' + escapeHtml(warnings.join('; '));
      $("monStatus").innerHTML = status + '</span>';
    } catch (err) {
      if (token !== state.monFetchToken) return;
      $("monStatus").innerHTML = '<span class="error-msg" role="alert">Kon rijksmonumenten niet laden: ' + escapeHtml(err.message) + '</span>';
    }
  }

  // "|" als scheidingsteken (op verzoek) i.p.v. komma -- geen quote-escaping nodig zoals bij een
  // komma-CSV, alleen een letterlijke "|" of een regeleinde in een tekstveld zou de kolommen laten
  // verschuiven; die komen in de brondata niet voor, maar worden voor de zekerheid toch vervangen.
  function csvField(value) {
    if (value === null || value === undefined) return "";
    return String(value).replace(/\|/g, "/").replace(/[\r\n]+/g, " ").trim();
  }

  // Platte, gedenormaliseerde CSV: de aardbevinggegevens worden op elke monumentrij herhaald
  // (gangbaar patroon voor een-op-veel-exports, werkt meteen goed in Excel/Sheets). Gebruikt de
  // straal-resultaten zoals ze nu op de kaart staan (state.lastMonuments), niet een nieuwe query.
  function buildMonumentsCsv() {
    var ev = state.selected;
    var header = [
      "Aardbeving_Plaats", "Aardbeving_Datum", "Aardbeving_Magnitude", "Aardbeving_Diepte_km",
      "Straal_km", "Monumentnummer", "Monument_Naam", "Monument_Type",
      "Functie_Oorspronkelijk", "Functie_Huidig", "Afstand_tot_epicentrum_km",
      "Impactindicatie", "Effectgebied", "Versterkingsprogramma", "Monumentenregister_URL",
      "Linked_data_URI"
    ];
    var rows = [header.join("|")];
    var mag = ev ? ev.mag : null;
    var depth = ev ? ev.depth : null;
    // Respecteert een actief filter (monumentaard/functie) -- export wat er nu getoond wordt,
    // i.p.v. altijd de volledige, ongefilterde straal-resultaten.
    var toExport = state.monumentFilter
      ? state.lastMonuments.filter(function (m) { return monumentMatchesFilter(m, state.monumentFilter); })
      : state.lastMonuments;
    toExport.forEach(function (m) {
      var score = (mag !== null && m.distKm !== null) ? impactScore(mag, depth, m.distKm) : null;
      var row = [
        csvField(ev ? ev.place : ""),
        csvField(ev && ev.sourceEvent ? ev.sourceEvent.date : ""),
        csvField(mag !== null ? mag.toFixed(1) : ""),
        csvField(depth !== null ? depth : ""),
        csvField(state.radiusKm),
        csvField(m.nr),
        csvField(m.naam),
        csvField(m.type === "archeologisch" ? "archeologisch" : "onroerend gebouwd"),
        csvField(stripParenSuffix(m.functieOorspr || "")),
        csvField(stripParenSuffix(m.functieHuidig || "")),
        csvField(m.distKm !== null ? m.distKm.toFixed(1) : ""),
        csvField(score !== null ? score.toFixed(1) : ""),
        csvField(score === null ? "" : (score >= 0 ? "binnen indicatief effectgebied" : "buiten indicatief effectgebied")),
        csvField(VERSTERKINGSPROGRAMMA_NRS.has(m.nr) ? "ja" : "nee"),
        csvField(MONUMENTENREGISTER_URL + m.nr),
        csvField(m.uri)
      ];
      rows.push(row.join("|"));
    });
    return rows.join("\r\n");
  }

  function downloadMonumentsCsv() {
    if (!state.lastMonuments.length) {
      $("monStatus").innerHTML = '<span class="placeholder">Nog geen rijksmonumenten om te downloaden - selecteer eerst een epicentrum.</span>';
      return;
    }
    var csv = buildMonumentsCsv();
    var blob = new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8;" }); // BOM voor correcte accenten in Excel
    var url = URL.createObjectURL(blob);
    var place = state.selected && state.selected.place ? state.selected.place : "epicentrum";
    var safePlace = place.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    var a = document.createElement("a");
    a.href = url;
    a.download = "rijksmonumenten_" + safePlace + "_" + state.radiusKm + "km.csv";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Gedeeld door renderMonuments() (straal-resultaten) en de rijksmonumentnummer-opzoeking:
  // zelfde icoon/kleur/ring/popup-logica, zodat er geen tweede visuele taal ontstaat.
  function buildMonumentMarker(m) {
    var mag = state.selected ? state.selected.mag : null;
    var depth = state.selected ? state.selected.depth : null;
    var score = (mag !== null && m.distKm !== null) ? impactScore(mag, depth, m.distKm) : null;
    var color = impactColor(score);
    var inVersterking = VERSTERKINGSPROGRAMMA_NRS.has(m.nr);
    // divIcon i.p.v. L.rectangle: vaste pixelgrootte (net als de aardbeving-cirkels), zodat het
    // icoon ook bij uitgezoomde weergaven zichtbaar blijft in plaats van te verdwijnen. Bij
    // inVersterking groeit de iconSize mee met de extra ring (zie monumentIconSvg) -- één
    // marker/icoon, geen los ring-element, om click-volgorde-problemen te vermijden.
    var px = inVersterking ? MONUMENT_ICON_PX + VERSTERKING_RING_MARGIN : MONUMENT_ICON_PX;
    var icon = L.divIcon({
      className: "",
      html: monumentIconSvg(m.type, color, inVersterking),
      iconSize: [px, px],
      iconAnchor: [px / 2, px / 2]
    });
    var rect = L.marker([m.lat, m.lon], { icon: icon });
    rect.bindPopup(
      '<div class="eq-info">' +
      '<b>' + (m.naam ? escapeHtml(m.naam) : "Rijksmonument nr. " + escapeHtml(m.nr)) + '</b><br>' +
      (m.naam ? "Rijksmonument nr. " + escapeHtml(m.nr) + '<br>' : "") +
      (m.functieOorspr ? "Oorspronkelijke functie: " + escapeHtml(stripParenSuffix(m.functieOorspr)) + '<br>' : "") +
      (m.functieHuidig ? "Huidige functie: " + escapeHtml(stripParenSuffix(m.functieHuidig)) + '<br>' : "") +
      (m.aard ? "Monumentaard: " + escapeHtml(m.aard) + '<br>' : "") +
      (inVersterking ? '<span style="color:' + VERSTERKING_RING_COLOR + '">&#9679; In het officiële RCE-versterkingsprogramma</span><br>' : "") +
      (score !== null ? "Afstand tot epicentrum: " + m.distKm.toFixed(1) + ' km<br>Impactindicatie <span class="info-icon" title="Verkennende indicatie, geen schadebeoordeling.">ⓘ</span>: ' + score.toFixed(1) +
        (score >= 0 ? " (binnen indicatief effectgebied)" : " (buiten indicatief effectgebied)") +
        (isImpactLowConfidence(depth) ? " - let op: diepe beving, kalibratie minder betrouwbaar op afstand" : "") + '<br>' : "") +
      '<a href="' + MONUMENTENREGISTER_URL + m.nr + '" target="_blank" rel="noopener">Bekijk in monumentenregister</a><br>' +
      '<a href="' + m.uri + '" target="_blank" rel="noopener">Linked-data URI</a>' +
      '</div>'
    );
    return rect;
  }

  function renderMonuments(monuments) {
    monLayer.clearLayers();
    monuments.forEach(function (m) { buildMonumentMarker(m).addTo(monLayer); });
    // Dedup altijd tegen de VOLLEDIGE, ongefilterde straal-resultaten -- anders zou een actief
    // filter (monumentaard/functie) de zoekresultaat-marker laten "terugkomen" zodra het gefilterde
    // monument niet meer in de zichtbare subset zit, terwijl het wel degelijk nog in de straal ligt.
    renderMonSearchMarker(state.lastMonuments);
  }

  var AARD_LABELS = { gebouwd: "Onroerend gebouwd", archeologisch: "Archeologisch" };
  var MAX_FUNCTIE_CHIPS = 12;

  function computeMonumentCounts(monuments) {
    var aard = {}, functie = {};
    monuments.forEach(function (m) {
      aard[m.type] = (aard[m.type] || 0) + 1;
      if (m.functieOorspr) {
        var f = stripParenSuffix(m.functieOorspr);
        functie[f] = (functie[f] || 0) + 1;
      }
    });
    return { aard: aard, functie: functie };
  }

  function monumentMatchesFilter(m, filter) {
    if (!filter) return true;
    if (filter.field === "type") return m.type === filter.value;
    if (filter.field === "functieOorspr") return m.functieOorspr && stripParenSuffix(m.functieOorspr) === filter.value;
    return true;
  }

  // Filtert client-side over de al opgehaalde straal-resultaten (state.lastMonuments) -- geen
  // nieuwe query nodig, dus geen "database" vereist zoals de gebruiker vreesde: het is gewoon een
  // array-filter/group-by over data die al in het geheugen staat zodra er een epicentrum is
  // gekozen. Aard/functie-labels zijn de officiële RCE-thesaurustermen (skos:prefLabel) en kunnen
  // dus samengestelde waarden bevatten (bv. "Kasteel, buitenplaats") -- geaccepteerd, niet op te
  // splitsen zonder van de brondata af te wijken.
  function applyMonumentFilter() {
    var monuments = state.lastMonuments;
    var filtered = state.monumentFilter
      ? monuments.filter(function (m) { return monumentMatchesFilter(m, state.monumentFilter); })
      : monuments;
    renderMonuments(filtered);
    renderMonumentFilterPanel();
  }

  function renderMonumentFilterPanel() {
    var monuments = state.lastMonuments;
    var panel = $("monumentFilterPanel");
    var body = $("monumentFilterBody");
    if (!monuments.length) { panel.style.display = "none"; body.innerHTML = ""; return; }

    var counts = computeMonumentCounts(monuments);
    // Filter dat door een straal-/epicentrum-wijziging niet meer voorkomt automatisch opheffen,
    // anders blijft er een "onzichtbaar" filter actief dat niets meer laat zien en dat je nergens
    // meer kunt uitzetten (de bijbehorende knop staat er dan niet meer).
    if (state.monumentFilter) {
      var stillExists = state.monumentFilter.field === "type"
        ? counts.aard[state.monumentFilter.value] > 0
        : counts.functie[state.monumentFilter.value] > 0;
      if (!stillExists) state.monumentFilter = null;
    }

    panel.style.display = "";
    var html = "";
    if (state.monumentFilter) {
      var label = state.monumentFilter.field === "type" ? AARD_LABELS[state.monumentFilter.value] : state.monumentFilter.value;
      var matchCount = state.monumentFilter.field === "type" ? counts.aard[state.monumentFilter.value] : counts.functie[state.monumentFilter.value];
      html += '<div class="filter-active-row">Filter: <b>' + escapeHtml(label) + '</b> (' + matchCount + ' van ' + monuments.length + ')' +
        ' <button type="button" id="clearMonumentFilterBtn">Wis</button></div>';
    }

    var aardKeys = Object.keys(counts.aard).sort(function (a, b) { return counts.aard[b] - counts.aard[a]; });
    html += '<div class="filter-group"><h3>Monumentaard</h3>';
    aardKeys.forEach(function (k) {
      var isActive = state.monumentFilter && state.monumentFilter.field === "type" && state.monumentFilter.value === k;
      html += '<button type="button" class="filter-chip' + (isActive ? ' active' : '') + '" data-field="type" data-value="' + escapeHtml(k) + '">' +
        escapeHtml(AARD_LABELS[k] || k) + ' <span class="filter-count">(' + counts.aard[k] + ')</span></button>';
    });
    html += '</div>';

    var functieKeysAll = Object.keys(counts.functie).sort(function (a, b) { return counts.functie[b] - counts.functie[a]; });
    var functieKeys = functieKeysAll.slice(0, MAX_FUNCTIE_CHIPS);
    if (functieKeys.length) {
      html += '<div class="filter-group"><h3>Oorspronkelijke functie</h3>';
      functieKeys.forEach(function (k) {
        var isActive = state.monumentFilter && state.monumentFilter.field === "functieOorspr" && state.monumentFilter.value === k;
        html += '<button type="button" class="filter-chip' + (isActive ? ' active' : '') + '" data-field="functieOorspr" data-value="' + escapeHtml(k) + '">' +
          escapeHtml(k) + ' <span class="filter-count">(' + counts.functie[k] + ')</span></button>';
      });
      if (functieKeysAll.length > MAX_FUNCTIE_CHIPS) {
        html += '<div class="hint">+ ' + (functieKeysAll.length - MAX_FUNCTIE_CHIPS) + ' andere functies (niet apart getoond)</div>';
      }
      html += '</div>';
    }

    body.innerHTML = html;

    body.querySelectorAll(".filter-chip").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var field = btn.getAttribute("data-field");
        var value = btn.getAttribute("data-value");
        state.monumentFilter = (state.monumentFilter && state.monumentFilter.field === field && state.monumentFilter.value === value)
          ? null
          : { field: field, value: value };
        applyMonumentFilter();
      });
    });
    var clearBtn = $("clearMonumentFilterBtn");
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        state.monumentFilter = null;
        applyMonumentFilter();
      });
    }
  }

  // Houdt de rijksmonumentnummer-zoekresultaat-marker actueel en dupliceervrij i.p.v. een
  // eenmalige, verouderende marker (gemeld: bleef grijs/verouderd staan nadat de gebruiker elders
  // op de kaart verder was gegaan, en verscheen soms dubbel -- net niet overlappend -- naast de
  // straal-marker van hetzelfde monument). Hertekent bij elke straal-wijziging met de actuele
  // kleur/score, en slaat de marker over als het monument toch al in de straal-resultaten zit.
  function renderMonSearchMarker(straalMonumenten) {
    monSearchLayer.clearLayers();
    var m = state.lastMonSearch;
    if (!m) return;
    var alreadyShown = (straalMonumenten || []).some(function (sm) { return sm.nr === m.nr; });
    if (alreadyShown) return;
    // m.distKm is altijd null (de nummer-opzoeking heeft geen afstandsfilter/-berekening) --
    // zonder dit opnieuw te berekenen tov het actuele epicentrum blijft impactScore() altijd null
    // en de marker dus permanent grijs, ongeacht latere epicentrum-selecties (precies de bug die
    // hier gefixt wordt: de marker moet meebewegen met de actuele selectie).
    var mWithDist = m;
    if (state.selected) {
      mWithDist = Object.assign({}, m, {
        distKm: haversineKm(state.selected.lat, state.selected.lon, m.lat, m.lon)
      });
    }
    buildMonumentMarker(mWithDist).addTo(monSearchLayer);
  }

  function populatePlaceList() {
    var seen = {};
    state.events.forEach(function (ev) { if (ev.place) seen[ev.place] = true; });
    var sorted = Object.keys(seen).sort(function (a, b) { return a.localeCompare(b, "nl"); });
    $("placeList").innerHTML = sorted.map(function (p) {
      return '<option value="' + escapeHtml(p) + '">';
    }).join("");
  }

  function initPlaceSearch() {
    var input = $("placeSearch");
    function newestEvent(events) {
      return events.slice().sort(function (a, b) {
        return new Date(b.date) - new Date(a.date);
      })[0] || null;
    }

    function trySelect() {
      var q = input.value.trim().toLowerCase();
      if (!q) { $("placeStatus").textContent = ""; return; }

      var matches = state.events.filter(function (ev) {
        return ev.place && ev.place.toLowerCase() === q;
      });

      if (!matches.length) {
        matches = state.events.filter(function (ev) {
          return ev.place && ev.place.toLowerCase().indexOf(q) === 0;
        });
      }

      var match = newestEvent(matches);
      if (!match) {
        $("placeStatus").textContent = "Geen aardbeving gevonden bij deze plaatsnaam.";
        return;
      }

      $("placeStatus").textContent = "";
      resetTimeFilter(); // zoekresultaat moet altijd zichtbaar zijn, ongeacht animatiepositie
      map.setView([match.lat, match.lon], 12);
      selectEpicenter(match.lat, match.lon, match.mag, match.depth, match.place, match);
    }
    input.addEventListener("change", trySelect);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") trySelect(); });
  }

  function initMonNrSearch() {
    var input = $("monNrSearch");
    var statusEl = $("monNrStatus");

    async function trySearch() {
      var raw = input.value.trim();
      if (!raw) { statusEl.innerHTML = ""; return; }
      // Bewuste whitelist-validatie vooraf -- ceo:rijksmonumentnummer is xsd:string (niet
      // xsd:integer, bevestigd in de rce-cho-ontologiedocumentatie), dus de waarde wordt gequote
      // in de query; zonder deze check zou vrije tekstinvoer rechtstreeks in de SPARQL-querystring
      // belanden (injectierisico). Dit is de enige plek in de app met vrije gebruikersinvoer die
      // in een query terechtkomt.
      if (!/^\d+$/.test(raw)) {
        statusEl.innerHTML = '<span class="error-msg" role="alert">Vul een rijksmonumentnummer in van alleen cijfers.</span>';
        return;
      }

      statusEl.innerHTML = loadingHtml("Rijksmonument opzoeken…");
      try {
        var bindings = await sparqlSelect(MON_ENDPOINT, buildMonumentByNumberQuery(raw));
        var matches = mapMonumentByNumberBindings(bindings);
        if (!matches.length) {
          statusEl.innerHTML = '<span class="placeholder">Geen geldig rijksmonument gevonden met nummer ' + escapeHtml(raw) + ' (mogelijk een ongeldig nummer, of een andere status dan "rijksmonument").</span>';
          state.lastMonSearch = null;
          renderMonSearchMarker(null);
          return;
        }
        var m = matches[0];

        // Bewaard in state (i.p.v. alleen eenmalig getekend) zodat de marker meegroeit met latere
        // straal-/epicentrum-wijzigingen: renderMonSearchMarker() wordt bij elke renderMonuments()
        // opnieuw aangeroepen, houdt 'm actueel qua kleur, en slaat 'm over zodra dezelfde
        // rijksmonumentnummer al in de straal-resultaten zit (voorkomt een dubbele/verouderde
        // marker, gemeld door de gebruiker).
        state.lastMonSearch = m;
        renderMonSearchMarker(null);
        map.setView([m.lat, m.lon], 15);
        var searchMarkers = monSearchLayer.getLayers();
        if (searchMarkers.length) searchMarkers[0].openPopup();

        var nearest = nearestEarthquake(m.lat, m.lon);
        var resultHtml = '<div class="eq-info">' +
          '<b>' + (m.naam ? escapeHtml(m.naam) : "Rijksmonument nr. " + escapeHtml(m.nr)) + '</b> gevonden.<br>';
        if (nearest) {
          var ev = nearest.event;
          var dateStr = ev.date ? new Date(ev.date).toLocaleDateString("nl-NL") : "onbekende datum";
          resultHtml += 'Dichtstbijzijnde aardbeving: ' + dateStr +
            (ev.mag !== null ? ' · M' + ev.mag.toFixed(1) : '') +
            ' · ' + nearest.distKm.toFixed(1) + ' km<br>' +
            '<button type="button" id="selectNearestBtn">Selecteer deze aardbeving als epicentrum</button>';
        } else {
          resultHtml += 'Geen aardbevingen in de dataset om afstand tegen te vergelijken.';
        }
        resultHtml += '</div>';
        statusEl.innerHTML = resultHtml;

        if (nearest) {
          $("selectNearestBtn").addEventListener("click", function () {
            resetTimeFilter();
            selectEpicenter(nearest.event.lat, nearest.event.lon, nearest.event.mag, nearest.event.depth, nearest.event.place, nearest.event);
          });
        }
      } catch (err) {
        statusEl.innerHTML = '<span class="error-msg" role="alert">Kon rijksmonument niet opzoeken: ' + escapeHtml(err.message) + '</span>';
      }
    }

    $("monNrSearchBtn").addEventListener("click", trySearch);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") trySearch(); });

    $("monNrResetBtn").addEventListener("click", function () {
      input.value = "";
      statusEl.innerHTML = "";
      state.lastMonSearch = null;
      renderMonSearchMarker(null);
    });
  }

  function initSlider() {
    var slider = $("radiusSlider");
    slider.value = state.radiusKm;
    slider.setAttribute("aria-valuetext", state.radiusKm + " kilometer");
    $("radiusVal").textContent = state.radiusKm + " km";
    slider.addEventListener("input", function () {
      state.radiusKm = parseInt(slider.value, 10);
      $("radiusVal").textContent = state.radiusKm + " km";
      slider.setAttribute("aria-valuetext", state.radiusKm + " kilometer");
      drawRadiusCircle();
      renderEqStats();
      fetchMonumentsDebounced();
    });
  }

  // Legenda als Leaflet-control op de kaart (i.p.v. vaste ruimte in de zijbalk) -- hergebruikt
  // dezelfde kleur/icoon-functies als de rest van de kaart, zodat legenda en weergave nooit uit
  // de pas kunnen lopen. Standaard ingeklapt, klik op de titel om te openen.
  function buildLegendHtml() {
    return '<button type="button" class="legend-control-header" aria-expanded="false">Legenda ▸</button>' +
      '<div class="legend-control-body" style="display:none">' +
      '<div class="legend-item"><span class="legend-dot" style="background:' + CATEGORY_COLORS["geïnduceerde aardbevingen"] + '"></span>Geïnduceerde aardbeving</div>' +
      '<div class="legend-item"><span class="legend-dot" style="background:' + CATEGORY_COLORS["tektonische aardbevingen"] + '"></span>Tektonische aardbeving</div>' +
      '<div class="legend-item"><span class="legend-square" style="background:' + MONUMENT_COLOR_IN + '"></span>Rijksmonument-kleur - ruim binnen indicatie</div>' +
      '<div class="legend-item"><span class="legend-square" style="background:' + MONUMENT_COLOR_NET + '"></span>Rijksmonument-kleur - net binnen indicatie</div>' +
      '<div class="legend-item"><span class="legend-square" style="background:' + MONUMENT_COLOR_OUT + '"></span>Rijksmonument-kleur - buiten indicatie</div>' +
      '<div class="legend-item">' + houseIconSvg(MONUMENT_COLOR_UNKNOWN) + '&nbsp;Rijksmonument-vorm - onroerend gebouwd</div>' +
      '<div class="legend-item">' + spadeIconSvg(MONUMENT_COLOR_UNKNOWN) + '&nbsp;Rijksmonument-vorm - archeologisch</div>' +
      '<div class="legend-item">' + monumentIconSvg("gebouwd", MONUMENT_COLOR_UNKNOWN, true) + '&nbsp;Paarse stippelring - zit in het officiële RCE-versterkingsprogramma</div>' +
      '<div class="hint">Impactindicatie <span class="info-icon" title="Verkennende indicatie, geen schadebeoordeling.">ⓘ</span>: verkennend, geen schadebeoordeling. Gekalibreerd op drie gepubliceerde IMG-effectgebieden: Wirdum M3,1 op 17,5 km, Huizinge M3,6 op meer dan 35 km en een IMG-voorbeeld van M2,7 op 9,5 km (trillingssnelheid 2 mm/s). Alleen bedoeld voor ondiepe, geïnduceerde bevingen tot 5 km diepte - bij diepe of tektonische bevingen is dit een ruwe extrapolatie.</div>' +
      '</div>';
  }

  var LegendControl = L.Control.extend({
    options: { position: "bottomleft" },
    onAdd: function () {
      var container = L.DomUtil.create("div", "legend-control");
      container.innerHTML = buildLegendHtml();
      L.DomEvent.disableClickPropagation(container);
      var header = container.querySelector(".legend-control-header");
      var body = container.querySelector(".legend-control-body");
      header.addEventListener("click", function () {
        var collapsed = body.style.display === "none";
        body.style.display = collapsed ? "" : "none";
        header.textContent = "Legenda " + (collapsed ? "▾" : "▸");
        header.setAttribute("aria-expanded", collapsed ? "true" : "false");
      });
      return container;
    }
  });

  // Tijd-animatie: toont aardbevingen cumulatief tot en met het gekozen jaar, om de opbouw (en
  // recente afname) van geinduceerde seismiciteit zichtbaar te maken. Werkt uitsluitend op de
  // kaartweergave -- de straal-statistieken en impactindicatie blijven altijd op de volledige, actuele
  // dataset gebaseerd, want die zijn bedoeld als complete analyse, niet als animatie.
  function updateTimeLabel() {
    $("timeYearLabel").textContent = state.timeFrom === null ? "alles" : (state.timeFrom + "–" + state.timeTo);
  }

  function updateRangeFill() {
    if (state.minYear === null || state.maxYear === null) return;
    var span = (state.maxYear - state.minYear) || 1;
    var from = state.timeFrom === null ? state.minYear : state.timeFrom;
    var to = state.timeTo === null ? state.maxYear : state.timeTo;
    var fromPct = ((from - state.minYear) / span) * 100;
    var toPct = ((to - state.minYear) / span) * 100;
    var fill = $("rangeFill");
    fill.style.left = fromPct + "%";
    fill.style.width = Math.max(0, toPct - fromPct) + "%";
  }

  function applyTimeRange(from, to) {
    state.timeFrom = from;
    state.timeTo = to;
    updateTimeLabel();
    updateRangeFill();
    renderEarthquakeMarkers();
  }

  function stopTimePlayback() {
    if (timePlayTimer) { clearInterval(timePlayTimer); timePlayTimer = null; }
    $("timePlayBtn").innerHTML = "&#9654;";
    $("timePlayBtn").title = "Afspelen";
    $("timePlayBtn").setAttribute("aria-label", "Afspelen");
  }

  // Afspelen houdt de linker (van-)handel vast en schuift de rechter (tot-)handel op tot het
  // eindjaar -- laat de opbouw zien binnen het gekozen startpunt, i.p.v. een vast venster te
  // verschuiven door de tijd.
  function startTimePlayback() {
    if (state.minYear === null || state.maxYear === null) return;
    var sliderTo = $("timeSliderTo");
    var from = state.timeFrom === null ? state.minYear : state.timeFrom;
    var current = state.timeTo === null || state.timeTo >= state.maxYear ? from : state.timeTo;
    $("timeSliderFrom").value = from;
    sliderTo.value = current;
    applyTimeRange(from, current);
    $("timePlayBtn").innerHTML = "&#10074;&#10074;";
    $("timePlayBtn").title = "Pauzeren";
    $("timePlayBtn").setAttribute("aria-label", "Pauzeren");
    timePlayTimer = setInterval(function () {
      current += 1;
      if (current > state.maxYear) { stopTimePlayback(); return; }
      sliderTo.value = current;
      applyTimeRange(from, current);
    }, 400);
  }

  function resetTimeFilter() {
    stopTimePlayback();
    if (state.minYear !== null) {
      $("timeSliderFrom").value = state.minYear;
      $("timeSliderTo").value = state.maxYear;
    }
    applyTimeRange(null, null);
  }

  function initTimeSlider() {
    if (state.minYear === null || state.maxYear === null) return;
    var sliderFrom = $("timeSliderFrom");
    var sliderTo = $("timeSliderTo");
    sliderFrom.min = sliderTo.min = state.minYear;
    sliderFrom.max = sliderTo.max = state.maxYear;
    sliderFrom.value = state.minYear;
    sliderTo.value = state.maxYear;
    state.timeFrom = null;
    state.timeTo = null;
    updateTimeLabel();
    updateRangeFill();
  }

  function initTimeControls() {
    var sliderFrom = $("timeSliderFrom");
    var sliderTo = $("timeSliderTo");
    sliderFrom.addEventListener("input", function () {
      stopTimePlayback();
      var from = parseInt(this.value, 10);
      var to = state.timeTo === null ? state.maxYear : state.timeTo;
      if (from > to) { to = from; sliderTo.value = to; }
      applyTimeRange(from, to);
    });
    sliderTo.addEventListener("input", function () {
      stopTimePlayback();
      var to = parseInt(this.value, 10);
      var from = state.timeFrom === null ? state.minYear : state.timeFrom;
      if (to < from) { from = to; sliderFrom.value = from; }
      applyTimeRange(from, to);
    });
    $("timePlayBtn").addEventListener("click", function () {
      if (timePlayTimer) { stopTimePlayback(); } else { startTimePlayback(); }
    });
    $("timeResetBtn").addEventListener("click", resetTimeFilter);
  }

  function initHelpToggle() {
    var btn = $("helpToggle");
    var body = $("helpBody");
    btn.addEventListener("click", function () {
      var open = body.style.display !== "none";
      body.style.display = open ? "none" : "block";
      btn.setAttribute("aria-expanded", String(!open));
    });
  }

  function initDownloadCsv() {
    $("downloadCsvBtn").addEventListener("click", downloadMonumentsCsv);
  }

  initMap();
  new LegendControl().addTo(map);
  initSlider();
  initPlaceSearch();
  initMonNrSearch();
  initTimeControls();
  initHelpToggle();
  initDownloadCsv();
  initNlogControls();
  loadNlogLayers();
  loadEarthquakes();
})();
</script>
</body>
</html>
