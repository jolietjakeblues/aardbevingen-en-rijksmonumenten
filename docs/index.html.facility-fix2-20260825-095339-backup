  function haversineKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // Zoekt over de VOLLEDIGE dataset (1911-heden), los van de tijdslider-animatie -- dezelfde
  // regel als bij de straal-statistieken/impactindicatie: animatie is presentatie, geen filter
  // op wat er geanalyseerd wordt.
  function nearestEarthquake(lat, lon) {
    var best = null, bestKm = Infinity;
    state.events.forEach(function (ev) {
      var km = haversineKm(lat, lon, ev.lat, ev.lon);
      if (km < bestKm) { bestKm = km; best = ev; }
    });
    return best ? { event: best, distKm: bestKm } : null;
  }

  // Impactindicator gekalibreerd op drie ECHTE, herleidbare IMG-effectgebieden (Instituut
  // Mijnbouwschade Groningen, trillingssnelheidsdrempel 2 mm/s / 1% overschrijdingskans,
  // Bommer et al.-methode) -- geen verzonnen coefficienten:
  //   M2.7 -> 9.5 km   (generiek IMG-voorbeeld, schadedoormijnbouw.nl "Effectgebied na een nieuwe beving")
  //   M3.1 -> 17.5 km  (Wirdum, 8 okt 2012, schadedoormijnbouw.nl)
  //   M3.6 -> >35 km   (Huizinge, 16 aug 2012, schadedoormijnbouw.nl / KNMI)
  // Lineaire regressie op (log10(Rh), M) voor deze 3 punten (diepte ~3 km, zoals gebruikelijk
  // voor het Groningenveld) geeft M = 1.646*log10(Rh) + 1.052, fit binnen 0.01 magnitude op
  // alle drie punten. Score = 0 komt overeen met de rand van het officiele effectgebied.
  // BELANGRIJKE BEPERKING: uitsluitend gekalibreerd op ondiepe (~3 km) geinduceerde bevingen.
  // Bij diepe/tektonische bevingen (bv. historische grensbevingen >10 km diep, andere bodem/
  // geologie) overschat dit model de impact op grote afstand aantoonbaar (getest tegen Roermond
  // 1992, M5.8/18km: reeel schadegebied ~15-20 km, dit model blijft tot ver daarbuiten positief
  // scoren) -- daarom een aparte, lagere-confidence markering vanaf 5 km diepte.
  var IMPACT_A = 1.646;
  var IMPACT_C = 1.052;
  var IMPACT_DEEP_THRESHOLD_KM = 5;

  function hypocentralDistanceKm(epiKm, depthKm) {
    var d = depthKm || 0;
    return Math.sqrt(epiKm * epiKm + d * d);
  }

  function impactScore(magnitude, depthKm, epiKm) {
    if (magnitude === null || magnitude === undefined || epiKm === null) return null;
    var rh = hypocentralDistanceKm(epiKm, depthKm);
    if (rh < 0.1) rh = 0.1;
    return magnitude - IMPACT_A * Math.log10(rh) - IMPACT_C;
  }

  function isImpactLowConfidence(depthKm) {
    return depthKm !== null && depthKm !== undefined && depthKm > IMPACT_DEEP_THRESHOLD_KM;
  }

  // Stoplicht: rood = ruim binnen effectgebied, oranje = net binnen effectgebied,
  // groen = buiten effectgebied (bewust niet grijs/gedimd -- moet ook op zee/water zichtbaar zijn).
  function impactColor(score) {
    if (score === null) return MONUMENT_COLOR_UNKNOWN;
    if (score >= 1) return MONUMENT_COLOR_IN;
    if (score >= 0) return MONUMENT_COLOR_NET;
    return MONUMENT_COLOR_OUT;
  }

  // Neemt het eerste coordinatenpaar uit een WKT-string (Point of Polygon) als representatief punt.
  function parseFirstLonLat(wkt) {
    var m = /(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)/.exec(wkt);
    if (!m) return null;
    return { lon: parseFloat(m[1]), lat: parseFloat(m[2]) };
  }

  function colorForCategory(label) {
    return CATEGORY_COLORS[label] || DEFAULT_COLOR;
